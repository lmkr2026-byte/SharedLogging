<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Identity & Metadata -->
    <PackageId>LMKR.Shared.Logging</PackageId>
    <Version>0.0.0</Version>
    <Authors>LMKR - Platform Engineering</Authors>
    <Company>LMKR</Company>
    <Description>Enterprise-grade shared logging library providing Serilog integration, request/response logging middleware, correlation ID propagation, and centralized API logging for all LMKR microservices.</Description>
    <PackageTags>logging;serilog;middleware;correlation-id;api-logging;shared</PackageTags>
    <PackageProjectUrl>https://github.com/lmkr2026-byte/SharedLogging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lmkr2026-byte/SharedLogging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>See https://github.com/lmkr2026-byte/SharedLogging/blob/main/CHANGELOG.md for detailed release notes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core middleware contracts -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="logging-guide\.github\workflows\auto-merge-dependabot.yml" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />

    <!-- Core Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="2.3.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Elasticsearch" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />

    <!-- Data access for the single logging stored procedure -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />

    <!-- Buffered request/response body capture without excess GC pressure -->
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="build\" />
  </ItemGroup>

</Project>

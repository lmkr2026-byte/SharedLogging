{
  "ConnectionStrings": {
    "ApisLogsManagement": "Server=your-sql-server;Database=ApisLogsManagement;Trusted_Connection=False;User Id=...;Password=...;TrustServerCertificate=True;"
  },

  "SharedLogging": {
    "ServiceName": "ParcelManagement.API",
    "HttpRequestLogging": true,
    "HttpResponseLogging": true,
    "LogBody": true,
    "MaxBodyLength": 8000
  },

  /* ---------------------------------------------------------------------
     THIS is the "configurable viewer" switch. LMKR.Shared.Logging bundles
     the Seq, Elasticsearch, Application Insights, File and Console sink
     packages, so any service can pick any combination below with ZERO
     code change and ZERO extra NuGet package - just edit this block per
     environment (Dev/QA/Prod can each point at a different viewer).
     Uncomment/keep only the sinks you want active.
     --------------------------------------------------------------------- */
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq.internal.lmkr.com:5341"
        }
      }
      // --- switch to Elasticsearch/Kibana instead, per environment: ---
      // {
      //   "Name": "Elasticsearch",
      //   "Args": {
      //     "nodeUris": "http://elk.internal.lmkr.com:9200",
      //     "indexFormat": "lmkr-logs-{0:yyyy.MM}"
      //   }
      // }
      // --- or Application Insights: ---
      // {
      //   "Name": "ApplicationInsights",
      //   "Args": {
      //     "connectionString": "InstrumentationKey=...",
      //     "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
      //   }
      // }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
